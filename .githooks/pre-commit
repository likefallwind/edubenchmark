#!/usr/bin/env bash
# Refuse to commit a blob GitHub will reject at push time.
#
# bash, not sh: the NUL-delimited `read -d ''` below is a bashism, and under
# dash it fails open -- the hook errors out and git commits anyway.
#
# GitHub hard-rejects any file over 100 MB. Once such a blob is in a commit,
# push fails even after a later commit shrinks the file, because push uploads
# every object in the history being sent -- so the fix is always a history
# rewrite. Catching it here keeps that out of the history in the first place.
#
# The usual source is an eval run that is still in flight: predictions are
# appended row by row and only re-packed into size-limited shards when the run
# finishes, so `git add -A` mid-run sweeps in an unpacked file. Wait for the
# run to finish, or pack it by hand:
#
#     python3 scripts/eval/predictions_io.py reports/eval/<bench>/<model>/
#
# Bypass with `git commit --no-verify` if you really mean it.

set -o pipefail

LIMIT=$((95 * 1024 * 1024))   # 95 MB, just under GitHub's 100 MB hard limit
offenders=$(
	git diff --cached --name-only --diff-filter=ACM -z |
		while IFS= read -r -d '' f; do
			sha=$(git rev-parse ":$f" 2>/dev/null) || continue
			size=$(git cat-file -s "$sha" 2>/dev/null) || continue
			[ "$size" -gt "$LIMIT" ] && printf '%s\t%s\n' "$size" "$f"
		done
)

[ -z "$offenders" ] && exit 0

echo "pre-commit: refusing to commit file(s) over 95 MB -- GitHub will reject the push." >&2
echo >&2
printf '%s\n' "$offenders" | while IFS="$(printf '\t')" read -r size f; do
	printf '  %6.1f MB  %s\n' "$(echo "$size" | awk '{print $1/1048576}')" "$f" >&2
done
echo >&2
echo "Unstage them and commit the rest:" >&2
printf '%s\n' "$offenders" | cut -f2 | sed 's/^/  git restore --staged /' >&2
echo >&2
echo "If a file is a still-running eval, let the run finish (it re-packs into" >&2
echo "shards on exit) or pack it now:" >&2
echo "  python3 scripts/eval/predictions_io.py <run_dir>" >&2
echo >&2
echo "Override with: git commit --no-verify" >&2
exit 1
